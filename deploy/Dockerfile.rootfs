FROM rust:1-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl python3 python3-pip git pkg-config libseccomp2 libsystemd0 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s ../local/cargo/bin/cargo /usr/bin/cargo \
    && ln -s ../local/cargo/bin/rustc /usr/bin/rustc \
    && mkdir -p /work /opt/survive /run
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/work/.cargo
ENV PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
